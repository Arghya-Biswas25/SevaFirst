{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@twin/core": ["packages/core/src/index.ts"],
      "@twin/twin-schema": ["packages/twin-schema/src/index.ts"],
      "@twin/twin-data": ["packages/twin-data/src/index.ts"],
      "@twin/nav": ["packages/nav/src/index.ts"],
      "@twin/geometry": ["packages/geometry/src/index.ts"],
      "@twin/render": ["packages/render/src/index.ts"],
      "@twin/interaction": ["packages/interaction/src/index.ts"],
      "@twin/hazard-sdk": ["packages/hazard-sdk/src/index.ts"],
      "@twin/routing": ["packages/routing/src/index.ts"],
      "@twin/crowd": ["packages/crowd/src/index.ts"],
      "@twin/hazard-fire": ["packages/hazards/fire/src/index.ts"],
      "@twin/hazard-collapse": ["packages/hazards/collapse/src/index.ts"],
      "@twin/hazard-earthquake": ["packages/hazards/earthquake/src/index.ts"],
      "@twin/hazard-power": ["packages/hazards/power/src/index.ts"],
      "@twin/dispatch": ["packages/dispatch/src/index.ts"],
      "@twin/advisor": ["packages/advisor/src/index.ts"],
      "@twin/sim-runtime": ["packages/sim-runtime/src/index.ts"],
      "@twin/ui-kit": ["packages/ui-kit/src/index.tsx"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "apps/web/src/**/*.ts", "apps/web/src/**/*.tsx", "tests/**/*.ts", "data/**/*.json"],
  "exclude": ["node_modules", "**/dist"]
}
